rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'farazgaming0526@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMessage(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
             data.message is string && data.message.size() >= 2 && data.message.size() <= 5000 &&
             data.createdAt is string &&
             data.read is bool &&
             data.replied is bool;
    }

    // Public contact message submissions & Admin message management
    match /messages/{messageId} {
      allow create: if isValidId(messageId) &&
                       isValidMessage(incoming()) &&
                       incoming().read == false &&
                       incoming().replied == false;

      // Only administrators can view, mark read, or delete contact inquiries
      allow read, list, update, delete: if isAdmin() && isValidId(messageId);
    }

    // Public business services catalog
    match /services/{serviceId} {
      allow read, list: if true;
      allow write: if isAdmin() && isValidId(serviceId);
    }

    // Public project portfolio
    match /projects/{projectId} {
      allow read, list: if true;
      allow write: if isAdmin() && isValidId(projectId);
    }

    // Public site configuration
    match /siteSettings/{settingId} {
      allow read, list: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Administrators registry
    match /admins/{adminId} {
      allow read, write: if isAdmin() && isValidId(adminId);
    }
  }
}
